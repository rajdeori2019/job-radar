# JobRadar — copy this file to .env and add your own free API keys.
# At least ONE of Adzuna or JSearch is required for verified-date results.

# Adzuna (free tier) — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI (free tier) — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# Tavily (optional, web-search fallback; results labeled "date not verified")
# https://tavily.com/
TAVILY_API_KEY=

# Server port (optional)
PORT=3000
